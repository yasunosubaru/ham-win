<Application x:Class="Ham.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ham.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:NavVisibilityConverter x:Key="NavVisibility" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:ScoreToBrushConverter x:Key="ScoreToBrush" />
            <conv:EnumLabelConverter x:Key="EnumLabel" />
            <conv:ReminderLabelConverter x:Key="ReminderLabel" />
            <conv:BarWidthConverter x:Key="BarWidthConverter" />
            <conv:SemesterLabelConverter x:Key="SemesterLabel" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
