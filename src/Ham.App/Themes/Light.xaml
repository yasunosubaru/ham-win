<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Ham 品牌色取自官方规范 #4478a8 -->
    <Color x:Key="BrandColor">#4478A8</Color>
    <Color x:Key="BrandHoverColor">#3A6A96</Color>
    <Color x:Key="BrandLightColor">#A8C8E8</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="BrandLightBrush" Color="{StaticResource BrandLightColor}" />

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E3E6EB" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F242E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA1AC" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#3F9C6D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C88A2E" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C4524A" />
    <SolidColorBrush x:Key="InfoBrush" Color="#4478A8" />

    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#E8EFF6" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F2F5" />

    <!-- 课程配色板：与 Core 层 CourseColorAssigner.Palette 保持一致 -->
    <SolidColorBrush x:Key="Course1" Color="#F3A5A5" />
    <SolidColorBrush x:Key="Course2" Color="#D6A5E0" />
    <SolidColorBrush x:Key="Course3" Color="#C7A5E6" />
    <SolidColorBrush x:Key="Course4" Color="#B5A5E1" />
    <SolidColorBrush x:Key="Course5" Color="#A5B9F3" />
    <SolidColorBrush x:Key="Course6" Color="#A5D6F4" />
    <SolidColorBrush x:Key="Course7" Color="#A5E3F4" />
    <SolidColorBrush x:Key="Course8" Color="#A5E6E1" />
    <SolidColorBrush x:Key="Course9" Color="#C7F3B5" />
    <SolidColorBrush x:Key="Course10" Color="#D6F3A5" />
    <SolidColorBrush x:Key="Course11" Color="#E6F3A5" />
    <SolidColorBrush x:Key="Course12" Color="#F3F3A5" />
    <SolidColorBrush x:Key="Course13" Color="#F3E6A5" />
    <SolidColorBrush x:Key="Course14" Color="#F3D6A5" />
    <SolidColorBrush x:Key="Course15" Color="#F3C7A5" />
    <SolidColorBrush x:Key="Course16" Color="#C7B5A5" />
    <SolidColorBrush x:Key="Course17" Color="#D6D6D6" />
    <SolidColorBrush x:Key="Course18" Color="#B5C7D6" />

    <sys:Double x:Key="CardCornerRadiusValue">10</sys:Double>
    <CornerRadius x:Key="CardCornerRadius" TopLeft="10" TopRight="10" BottomLeft="10" BottomRight="10" />
    <CornerRadius x:Key="SmallCornerRadius" TopLeft="6" TopRight="6" BottomLeft="6" BottomRight="6" />

    <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
