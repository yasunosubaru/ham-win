<UserControl x:Class="Ham.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 真实数据来源与同步 -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="分馆" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                        <ComboBox Width="130" ItemsSource="{Binding Libraries}"
                                  SelectedItem="{Binding Library}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LiveAreaSummary}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"
                                   Text="数据来自武汉大学图书馆座位预约系统 seat.lib.whu.edu.cn，需先在「设置 → 登录并同步」完成信息门户登录。" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="前一天" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding PrevDayCommand}" Margin="0,0,6,0" Padding="12,5" />
                        <TextBlock Text="{Binding Date, StringFormat='yyyy-MM-dd'}" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Content="后一天" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding NextDayCommand}" Margin="0,0,12,0" Padding="12,5" />
                        <Button Content="同步余座" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SyncAreasCommand}" Padding="16,5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 区域余座 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitleStyle}" Text="各区域余座" />

                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedTextStyle}" Margin="0,-4,0,8"
                               Text="按空闲比例从高到低排序。此处显示的是真实余座数据，不是示例。" />

                    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0"
                                Visibility="{Binding HasLiveAreas, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding LiveAreas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding AreaName}" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <ProgressBar Height="6" Margin="0,5,12,0" Minimum="0" Maximum="1"
                                                         Value="{Binding FreeRatio, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrandBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="余 {0} / {1}">
                                                    <Binding Path="FreeSeats" />
                                                    <Binding Path="TotalSeats" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasLiveAreas, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                        <TextBlock Text="尚未同步真实余座数据。" FontSize="14" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                                   Text="先在「设置 → 登录并同步」完成信息门户登录，再回到这里点「同步余座」。"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="我的预约" />
                        <ItemsControl ItemsSource="{Binding Bookings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Describe()}" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                                   Text="{Binding Status, Converter={StaticResource EnumLabel}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="暂无预约记录。" Style="{StaticResource MutedTextStyle}"
                                   Visibility="{Binding Bookings.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Empty}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="为什么不能直接预约" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="图书馆的预约、取消与签到都需要图形验证码并受服务端风控约束。本应用只做余座查询与预约记录读取，不代为预约，以免出现「本地显示已约上、实际并未约上」的误导。请到 seat.lib.whu.edu.cn 或「武汉大学图书馆」公众号完成预约。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="当前预约" />
                        <TextBlock Text="{Binding ActiveBookingText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                                   Text="{Binding PreferredSeatText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
