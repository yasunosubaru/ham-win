<UserControl x:Class="Ham.App.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 最近日程 -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="最近日程" />
                    <ContentControl Content="{Binding Nearest}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource NavSelectedBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding Start, Mode=OneWay, StringFormat='yyyy-MM-dd HH:mm'}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Location, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Item.LinkedCourseName}" FontSize="11.5"
                                                   Margin="0,3,0,0" Foreground="{DynamicResource BrandBrush}"
                                                   Visibility="{Binding Item.LinkedCourseName, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <TextBlock Text="暂无进行中或即将到来的日程。" Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding Nearest, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 工具栏 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="添加日程" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddCommand}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <CheckBox Content="仅显示未过期" IsChecked="{Binding ShowOnlyUpcoming}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" Width="160" ItemsSource="{Binding Groups}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ActiveGroupId}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Occurrences}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                                        Padding="12,9" Margin="0,0,0,6" Cursor="Hand"
                                        MouseLeftButtonUp="Occurrence_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Start, StringFormat=MM-dd HH:mm}"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrandBrush}" />
                                            <TextBlock Text="{Binding Start, StringFormat=yyyy}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Location}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding Location, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding Item.Recurrence.Frequency, Converter={StaticResource EnumLabel}, ConverterParameter=Recurrence}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 右栏 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="日程详情" />
                        <TextBlock Text="{Binding SelectedDetail}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="编辑" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding EditCommand}" Margin="0,0,8,0" />
                            <Button Content="删除" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding Editor}">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="编辑日程" />

                        <TextBlock Text="名称" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="地点" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="开始时间" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding Start, StringFormat=yyyy-MM-dd\ HH:mm}" />

                        <CheckBox Content="设置结束时间" IsChecked="{Binding HasEnd}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding End, StringFormat=yyyy-MM-dd\ HH:mm}" Margin="0,4,0,0"
                                 IsEnabled="{Binding HasEnd}" />

                        <TextBlock Text="分组" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding GroupId}" />

                        <TextBlock Text="提前提醒" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding ReminderChoices}" SelectedItem="{Binding ReminderMinutes}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ReminderLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="重复" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Margin="0,0,8,0" />
                            <Button Content="取消" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
