<UserControl x:Class="Ham.App.Views.RatingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="32" FontSize="13.5"
                                 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 ToolTip="输入课程名或授课教师姓名，支持部分匹配" />
                        <Button Grid.Column="1" Content="清空" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ClearCommand}" Margin="8,0,0,0" Padding="14,6" />
                        <Button Grid.Column="2" Content="搜索" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SearchCommand}" Margin="8,0,0,0" Padding="20,6" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitleStyle}" Text="搜索结果" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,-4,0,10" Text="{Binding EmptyHint}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                                                Padding="13,10" Margin="0,0,0,7" Cursor="Hand"
                                                MouseLeftButtonUp="Result_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding CourseName}" FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"
                                                               Text="{Binding Instructor}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding AverageText}"
                                                               FontSize="19" FontWeight="Bold"
                                                               Foreground="{DynamicResource BrandBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Style="{StaticResource MutedTextStyle}"
                                                               HorizontalAlignment="Right"
                                                               Text="{Binding TotalText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                            Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="给分分布" />
                            <TextBlock Text="{Binding SelectedDetail}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding Selected.Ranges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="10.5" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding Label}" />
                                            <Border Grid.Column="1" Height="13" CornerRadius="3"
                                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                            <TextBlock Grid.Column="2" FontSize="10.5" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Total}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="想上这门课" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding WishCommand}" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="我的评价" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"
                                       Text="评价以匿名方式发布；发布后才能查看其他同学的评论。" />
                            <Slider Minimum="1" Maximum="5" Value="{Binding ReviewScore}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right"
                                       Text="{Binding ReviewScore, StringFormat='评分 {0} / 5'}" />
                            <TextBox Text="{Binding ReviewText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                                     VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                            <Button Content="发布评价" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SubmitReviewCommand}" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="想上" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"
                                       Text="{Binding WishesHint}" />
                            <ItemsControl ItemsSource="{Binding Wishes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CourseName}" FontSize="12.5"
                                                   Margin="0,0,0,4"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </ScrollViewer>
</UserControl>
