<UserControl x:Class="Ham.App.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DataContext="{d:DesignInstance vm:StatusViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ham.App.ViewModels"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- 问候 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Greeting}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding UserDisplay}" FontSize="13" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TodayLabel}" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="8" Padding="14,10" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="综测 F2" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding DataContext.Score.ComprehensiveText,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource BrandBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 天气 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="天气" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Text="{Binding WeatherUpdatedText}" />
                            <Button Content="刷新" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RefreshWeatherCommand}" Padding="12,4" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding HasWeather, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="正在获取天气…" Style="{StaticResource MutedTextStyle}"
                                   Visibility="{Binding HasWeatherError, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                   Text="{Binding WeatherError, StringFormat='天气获取失败：{0}'}"
                                   Visibility="{Binding HasWeatherError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasWeather, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Weather.Icon}" FontSize="42"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Weather.TemperatureText}" FontSize="30"
                                               FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Weather.Condition}" FontSize="15" Margin="10,0,0,4"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"
                                           Text="{Binding WeatherAdvice}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right"
                                           Text="{Binding Weather.HumidityPercent, StringFormat='湿度 {0}%'}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right"
                                           Text="{Binding Weather.WindDirection}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right"
                                           Text="{Binding Weather.WindSpeedKmh, StringFormat='风速 {0:F0} km/h'}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Forecast}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                                            Padding="10,7" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DateLabel}" FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Icon}" FontSize="17" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Condition}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding TemperatureText}" FontSize="11.5"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource InfoBrush}"
                                                       Text="{Binding PrecipitationProbability, StringFormat='降水 {0}%'}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 今日课程 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="今日课程" />
                    <ItemsControl ItemsSource="{Binding TodayCourses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                                        Padding="12,9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4" CornerRadius="2"
                                                Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding Location, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Instructor, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding ClassFrom, Mode=OneWay}" />
                                            <Run Text="-" />
                                            <Run Text="{Binding ClassTo, Mode=OneWay}" />
                                            <Run Text=" 节" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="今天没有课程安排。"
                               Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding TodayCourses.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Empty}" />
                </StackPanel>
            </Border>

            <!-- 即将到来的日程 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="日程" />
                    <ItemsControl ItemsSource="{Binding UpcomingSchedules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Start, StringFormat=MM-dd HH:mm}"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrandBrush}" />
                                        <TextBlock Text="{Binding Start, StringFormat=ddd}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Location}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding Location, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="未来 7 天暂无日程。" Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding UpcomingSchedules.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Empty}" />
                </StackPanel>
            </Border>

            <!-- 校园服务摘要 -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="图书馆" />
                        <TextBlock Text="{Binding ActiveBookingText}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="运动" />
                        <TextBlock Text="{Binding PendingSportText}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />


                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="校巴" />
                        <TextBlock Text="{Binding NearestBusText}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />


                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
