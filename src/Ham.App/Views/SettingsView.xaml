<UserControl x:Class="Ham.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="860" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- 信息门户 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="信息门户" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{Binding SyncHint}" />
                        <TextBlock Text="学号" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBox Text="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="信息门户密码" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,4" />
                        <PasswordBox x:Name="PasswordBox" FontSize="13" Padding="8,6"
                                     BorderBrush="{DynamicResource BorderBrushSoft}"
                                     PasswordChanged="PasswordBox_Changed" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="密码仅保存在本机，用于自动登录信息门户获取课表与成绩，不会写入日志或上传。" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="保存设置" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SyncCommand}" Margin="0,0,8,0" />
                            <Button Content="登录并同步" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding SyncEducationCommand}" />
                            <Button Content="运行连接诊断" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding RunDiagnosticsCommand}" Margin="8,0,0,0" />
                        </StackPanel>

                        <!-- 诊断结果 -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                                Padding="12" Margin="0,12,0,0"
                                Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="连接诊断" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"
                                           Text="{Binding DiagnosticSummary}" />
                                <ItemsControl ItemsSource="{Binding DiagnosticSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="13" Width="20">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="•" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Passed">
                                                                    <Setter Property="Text" Value="✔" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Text" Value="✖" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                    <Setter Property="Text" Value="!" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 课表参数 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="课表" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="必须设置开学日期，Ham 才能确定当前处于第几教学周，从而准确地提醒上课。" />

                        <TextBlock Text="学年" Style="{StaticResource SectionHeaderStyle}" />
                        <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SemesterYear}" />

                        <TextBlock Text="学期" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding Semesters}" SelectedItem="{Binding SemesterNumber}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SemesterLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="开学日期" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding SemesterStartDate, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                                   Text="{Binding SemesterStartHint}" />

                        <TextBlock Text="学期周数" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding WeekOptions}" SelectedItem="{Binding TotalWeeks}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- 提醒 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="提醒" />
                        <CheckBox Content="启用通知" IsChecked="{Binding EnableNotifications}" Margin="0,0,0,6" />
                        <CheckBox Content="课程提醒" IsChecked="{Binding EnableCourseReminder}" Margin="0,0,0,6" />
                        <TextBlock Text="课程提前提醒" Style="{StaticResource SectionHeaderStyle}" Margin="0,6,0,4" />
                        <ComboBox ItemsSource="{Binding ReminderMinuteOptions}" SelectedItem="{Binding CourseReminderMinutes}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ReminderLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="日程提醒" IsChecked="{Binding EnableScheduleReminder}" Margin="0,10,0,0" />
                        <TextBlock Text="图书馆自动刷新间隔（分钟）" Style="{StaticResource SectionHeaderStyle}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding LibraryAutoRefreshMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="间隔过短可能导致图书馆系统临时限制账号，一般 15 分钟为宜。" />

                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                                Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="通知通道" Margin="0" />
                                <TextBlock FontSize="12.5" Text="{Binding NotificationChannel}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Text="{Binding NotificationError}"
                                           Foreground="{DynamicResource WarningBrush}" />
                                <Button Content="发送测试通知" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding TestNotificationCommand}" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Padding="14,5" />
                            </StackPanel>
                        </Border>

                        <!-- 提醒历史：系统通知会被 Windows 自动关闭，这里保证不丢 -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6"
                                Padding="10" Margin="0,10,0,0"
                                Visibility="{Binding HasNotificationHistory, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="提醒历史" Margin="0" />
                                    <Button Content="清空" Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding ClearHistoryCommand}"
                                            HorizontalAlignment="Right" Padding="10,2" Margin="0,-4,0,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"
                                           TextWrapping="Wrap"
                                           Text="Windows 的系统通知在鼠标悬停时会被自动关闭，这是系统行为、无法阻止。每条提醒同时记录在这里，因此不会丢失。" />
                                <ItemsControl ItemsSource="{Binding NotificationHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding KindText}" FontSize="10.5"
                                                               Foreground="{DynamicResource BrandBrush}" />
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Body}" FontSize="11.5"
                                                               TextWrapping="Wrap" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 外观 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="外观" />
                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                    </StackPanel>
                </Border>

                <!-- 数据 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="数据" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="当前状态" />
                        <TextBlock Text="{Binding SourceLabel}" FontSize="13" Margin="0,3,0,10"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="数据文件" />
                        <TextBlock Text="{Binding DataFilePath}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,3,0,10" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开数据目录" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                            <Button Content="载入演示数据" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding LoadDemoCommand}" Margin="0,0,8,0" />
                            <Button Content="清空数据" Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding ResetCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="关于" />
                        <TextBlock Text="Ham for Windows" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="面向武汉大学校园场景的桌面客户端，提供课程表、日程、成绩与绩点、图书馆、运动场馆、校巴与给分查询等功能。数据默认仅保存在本机。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
