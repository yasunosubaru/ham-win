<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ham.Ui.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:Ham.Ui"
    Title="登录信息门户">

    <Grid x:Name="Root" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 取消 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" Grid.Column="0"
                       Text="正在打开信息门户…" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" x:Name="Cancel" Content="取消" Click="OnCancel" />
        </Grid>

        <!--
          WebView2。NavigationCompleted 之前 Source 为空，这是正常的；
          流程里对空地址有专门处理，不要因为"一开始没有地址"就改判据。
        -->
        <Border Grid.Row="1" BorderThickness="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                CornerRadius="6">
            <muxc:WebView2 x:Name="Web" />
        </Border>

        <!-- 状态 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <muxc:ProgressRing x:Name="Busy" Grid.Column="0"
                               IsActive="True" Width="18" Height="18"
                               VerticalAlignment="Center" />
            <TextBlock x:Name="Status" Grid.Column="1" TextWrapping="Wrap"
                       VerticalAlignment="Center" Opacity="0.85" Text="准备中…" />
        </Grid>

        <TextBlock x:Name="Url" Grid.Row="3" FontSize="11" Opacity="0.5"
                   TextTrimming="CharacterEllipsis" Text="" />
    </Grid>
</Window>
