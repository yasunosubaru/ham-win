<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ham.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ham.Ui">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Padding="20,14" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="武汉大学" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <TextBlock x:Name="TermText" Grid.Column="1" VerticalAlignment="Center"
                       Opacity="0.7" HorizontalAlignment="Left" />

            <Button Grid.Column="2" x:Name="ThemeToggle" Content="切换主题" Click="OnThemeToggle" />
        </Grid>

        <!-- 侧边导航 + 内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="Nav" Grid.Column="0" SelectionMode="Single"
                      SelectionChanged="OnNavChanged" Padding="8,0">
                <ListViewItem Content="状态" Tag="status" />
                <ListViewItem Content="课程" Tag="course" />
                <ListViewItem Content="日程" Tag="schedule" />
                <ListViewItem Content="成绩" Tag="score" />
                <ListViewItem Content="图书馆" Tag="library" />
                <ListViewItem Content="运动" Tag="sport" />
                <ListViewItem Content="校巴" Tag="bus" />
                <ListViewItem Content="给分" Tag="rating" />
                <ListViewItem Content="设置" Tag="settings" />
            </ListView>

            <Frame x:Name="Content" Grid.Column="1" Padding="20,0,20,16" />
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <TextBlock x:Name="Status" Padding="20,8" Opacity="0.75"
                       TextTrimming="CharacterEllipsis" Text="就绪" />
        </Border>
    </Grid>
</Window>
